# inv-tui configuration.
# Copy to /etc/inv-tui.env (or ~/.config/inv-tui/env) on the target machine.
# Also accepts ~/.config/inv-tui/env, environment variables, and -flag overrides.
INVENTREE_URL=https://inv.example.net
INVENTREE_USERNAME=admin
INVENTREE_PASSWORD=changeme
# Touchscreen evdev device: auto (default), off, or /dev/input/eventN
INV_TUI_TOUCH=auto
# GPIO pin for the pigpiod buzzer (Pi only). 0 = disable. Default: 17
#INV_TUI_BUZZER_PIN=17
# Optional: OpenAI-compatible chat agent handoff (ctrl+h in search). Unset to disable.
HERMES_URL=http://hermes-host:8642
HERMES_KEY=changeme
#HERMES_MODEL=hermes-agent
